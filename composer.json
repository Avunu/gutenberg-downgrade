{
  "name": "avunu/gutenberg-downgrade",
  "description": "Load the Gutenberg 18.5 (WordPress 6.6 series) block editor on current WordPress releases, for sites whose page builder clashes with the modern editor. Configure via wp-config.php — no admin settings.",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "gutenberg",
    "block-editor"
  ],
  "homepage": "https://github.com/Avunu/gutenberg-downgrade",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Avunu LLC",
      "email": "mail@avu.nu"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "GutenbergDowngrade\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "platform-check": false,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --autoload-file=tests/tools/vendor/autoload.php --memory-limit=2G",
    "phpcs": "phpcs -q --standard=phpcs.xml.dist",
    "audit:blocks": "phpstan analyse -c tests/audit/phpstan-blocks.neon --memory-limit=2G && php tests/audit/check-blocks.php"
  }
}
