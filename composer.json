{
  "name": "avunu/gutenberg-downgrade",
  "description": "Load the Gutenberg 18.5 (WordPress 6.6 series) block editor on current WordPress releases, for sites whose page builder clashes with the modern editor. Configure via wp-config.php — no admin settings.",
  "type": "wordpress-plugin",
  "version": "1.1.0",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Avunu LLC",
      "email": "mail@avu.nu"
    }
  ],
  "require": {
    "php": ">=8.3",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^7.0",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "replace": {
    "phpstan/phpstan": "*"
  },
  "autoload": {
    "psr-4": {
      "GutenbergDowngrade\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "platform-check": false
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=2G",
    "phpcs": "phpcs -q --standard=phpcs.xml.dist",
    "audit:blocks": "phpstan analyse -c tests/audit/phpstan-blocks.neon --memory-limit=2G && php tests/audit/check-blocks.php"
  }
}
