{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2017",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2017", "DOM", "DOM.Iterable"],
		"types": [],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	// The assets/js shims are inlined verbatim into the package scripts they
	// patch by ScriptOverrides::shimScript(); they must stay plain ES2017.
	"include": ["assets/js/**/*.js", "types/**/*.d.ts"]
}
